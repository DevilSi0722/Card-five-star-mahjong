# Firebase 多人游戏配置（仅旧版 Vercel 分支需要；本分支已使用 Socket.IO 服务）
# 这些值在 Firebase 控制台 → 项目设置 → 「您的应用」(Web 应用) 中获取。
# 注意：NEXT_PUBLIC_ 前缀的变量会暴露到前端，这是正常的——真正的访问控制由 Firestore 安全规则负责。

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# 本机开发时，Next.js 前端连接独立实时服务；生产容器通过同源 /socket.io 自动连接。
# NEXT_PUBLIC_REALTIME_URL=http://127.0.0.1:3101
